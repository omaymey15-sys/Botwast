<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-transparent noir -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000099" />
        </shape>
    </item>

    <!-- Panneau contenu gris transparent -->
    <item
        android:left="32dp"
        android:right="32dp"
        android:top="100dp"
        android:bottom="100dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#66666688"
                android:endColor="#77777788" />
            <stroke
                android:color="#44444499"
                android:width="2dp" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>