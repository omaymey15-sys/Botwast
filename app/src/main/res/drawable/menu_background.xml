<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fond gradient gris transparent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#55555588"
                android:centerColor="#66666688"
                android:endColor="#77777788" />
        </shape>
    </item>

    <!-- Lignes de grille gris transparent -->
    <item
        android:top="100dp"
        android:bottom="300dp">
        <shape android:shape="rectangle">
            <stroke
                android:color="#44444466"
                android:width="1dp" />
        </shape>
    </item>

    <item
        android:top="200dp"
        android:bottom="200dp">
        <shape android:shape="rectangle">
            <stroke
                android:color="#44444466"
                android:width="1dp" />
        </shape>
    </item>

    <item
        android:top="300dp"
        android:bottom="100dp">
        <shape android:shape="rectangle">
            <stroke
                android:color="#44444466"
                android:width="1dp" />
        </shape>
    </item>
</layer-list>