<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ombre -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#00000066" />
        </shape>
    </item>
    
    <!-- Stick principal gris transparent -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="50%"
                android:startColor="#88888888"
                android:endColor="#66666688" />
        </shape>
    </item>
    
    <!-- Highlight transparent -->
    <item
        android:left="4dp"
        android:right="10dp"
        android:top="4dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#99999966" />
        </shape>
    </item>
    
    <!-- Bordure -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <stroke
                android:color="#44444499"
                android:width="1dp" />
        </shape>
    </item>
</layer-list>