<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ombre -->
    <item
        android:left="3dp"
        android:right="3dp"
        android:top="3dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000066" />
        </shape>
    </item>
    
    <!-- Gradient gris transparent -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#88888888"
                android:endColor="#66666688" />
        </shape>
    </item>
    
    <!-- Bordure -->
    <item
        android:left="3dp"
        android:right="3dp"
        android:top="3dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:color="#44444499"
                android:width="1dp" />
        </shape>
    </item>
</layer-list>