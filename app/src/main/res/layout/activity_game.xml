<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:id="@+id/gameContainer">

    <!-- Game Canvas -->
    <FrameLayout
        android:id="@+id/gameCanvasContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/controlsPanel"
        android:background="#000000" />

    <!-- Controls Panel TRANSPARENT -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_alignParentBottom="true"
        android:background="#00000000"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- JOYSTICK LEFT -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:alpha="0.5">

            <View
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/joystick_bg" />

            <View
                android:id="@+id/joystickStick"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:background="@drawable/joystick_stick" />

        </FrameLayout>

        <!-- D-PAD GAUCHE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="4dp"
            android:alpha="0.5">

            <Button
                android:id="@+id/dpadUp"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:text="↑"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#332196F3"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/dpadLeft"
                    android:layout_width="30dp"
                    android:layout_height="40dp"
                    android:text="←"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#332196F3"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/dpadRight"
                    android:layout_width="30dp"
                    android:layout_height="40dp"
                    android:text="→"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#332196F3"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <Button
                android:id="@+id/dpadDown"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:text="↓"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#332196F3"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- BOUTONS ACTION DROITE -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:alpha="0.5">

            <RelativeLayout
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center">

                <!-- Triangle -->
                <Button
                    android:id="@+id/buttonY"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:text="▲"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="#334CAF50"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentTop="true" />

                <!-- Carré -->
                <Button
                    android:id="@+id/buttonX"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:text="■"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="#33FF6B6B"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true" />

                <!-- Rond -->
                <Button
                    android:id="@+id/buttonB"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:text="●"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="#33FFA500"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true" />

                <!-- Croix -->
                <Button
                    android:id="@+id/buttonA"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="#332196F3"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true" />

            </RelativeLayout>

        </FrameLayout>

        <!-- BOUTONS L/R ET START/SELECT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="6dp"
            android:alpha="0.5">

            <!-- L et R -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/buttonL"
                    android:layout_width="45dp"
                    android:layout_height="30dp"
                    android:text="L"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#33757575"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/buttonR"
                    android:layout_width="45dp"
                    android:layout_height="30dp"
                    android:text="R"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#33757575"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- SELECT et START -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/buttonSelect"
                    android:layout_width="45dp"
                    android:layout_height="30dp"
                    android:text="SELECT"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#33616161"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/buttonStart"
                    android:layout_width="45dp"
                    android:layout_height="30dp"
                    android:text="START"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#33616161"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>