<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 🎮 GAME CANVAS -->
    <FrameLayout
        android:id="@+id/gameCanvasContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111111" />

    <!-- 🎮 OVERLAY CONTROLS -->
    <FrameLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 🕹️ JOYSTICK (LEFT BOTTOM) -->
        <ImageView
            android:id="@+id/joystickBase"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="28dp"
            android:alpha="0.25"
            android:src="@drawable/joystick_bg" />

        <ImageView
            android:id="@+id/joystickStick"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="58dp"
            android:alpha="0.35"
            android:src="@drawable/joystick_stick" />

        <!-- 🎮 D-PAD (OPTION LEFT) -->
        <ImageButton
            android:id="@+id/dpad"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="160dp"
            android:alpha="0.22"
            android:background="@android:color/transparent"
            android:src="@drawable/dpad" />

        <!-- 🔴 BUTTON X -->
        <ImageButton
            android:id="@+id/buttonX"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="30dp"
            android:alpha="0.30"
            android:background="@android:color/transparent"
            android:src="@drawable/btn_x" />

        <!-- 🔵 BUTTON O -->
        <ImageButton
            android:id="@+id/buttonO"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="90dp"
            android:layout_marginEnd="85dp"
            android:alpha="0.30"
            android:background="@android:color/transparent"
            android:src="@drawable/btn_o" />

        <!-- 🟩 BUTTON □ -->
        <ImageButton
            android:id="@+id/buttonSquare"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="90dp"
            android:layout_marginEnd="10dp"
            android:alpha="0.30"
            android:background="@android:color/transparent"
            android:src="@drawable/btn_square" />

        <!-- 🔺 BUTTON △ -->
        <ImageButton
            android:id="@+id/buttonTriangle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="150dp"
            android:layout_marginEnd="50dp"
            android:alpha="0.30"
            android:background="@android:color/transparent"
            android:src="@drawable/btn_triangle" />

        <!-- 🟡 START -->
        <TextView
            android:id="@+id/buttonStart"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:text="START"
            android:textColor="#FFFFFF"
            android:alpha="0.25"
            android:layout_gravity="bottom|center"
            android:layout_marginBottom="20dp" />

        <!-- ⚪ SELECT -->
        <TextView
            android:id="@+id/buttonSelect"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:text="SEL"
            android:textColor="#FFFFFF"
            android:alpha="0.25"
            android:layout_gravity="bottom|center"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="90dp" />

        <!-- 🟣 L -->
        <TextView
            android:id="@+id/buttonL1"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:text="L"
            android:textColor="#FFFFFF"
            android:alpha="0.25"
            android:layout_gravity="top|start"
            android:layout_margin="20dp" />

        <!-- 🟣 R -->
        <TextView
            android:id="@+id/buttonR1"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:text="R"
            android:textColor="#FFFFFF"
            android:alpha="0.25"
            android:layout_gravity="top|end"
            android:layout_margin="20dp" />

    </FrameLayout>

</FrameLayout>