<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:id="@+id/gameContainer">

    <!-- ÉCRAN DE JEU (Canvas) -->
    <FrameLayout
        android:id="@+id/gameCanvasContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/controlsPanel"
        android:background="#111111" />

    <!-- PANNEAU CONTRÔLES PSP STYLE -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_alignParentBottom="true"
        android:background="#1a1a1a"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- JOYSTICK GAUCHE -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_margin="8dp">

            <!-- Fond joystick -->
            <View
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="@drawable/joystick_bg" />

            <!-- Stick -->
            <View
                android:id="@+id/joystickStick"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:background="@drawable/joystick_stick" />

        </FrameLayout>

        <!-- SÉPARATEUR -->
        <View
            android:layout_width="2dp"
            android:layout_height="120dp"
            android:background="#333333"
            android:layout_margin="8dp" />

        <!-- BOUTONS D-PAD (Haut/Bas/Gauche/Droite) -->
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="120dp"
            android:layout_weight="0.8"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="4dp">

            <!-- D-Pad Haut -->
            <Button
                android:id="@+id/dpadUp"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:text="↑"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="#2196F3" />

            <!-- D-Pad Gauche/Droite -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginVertical="4dp">

                <Button
                    android:id="@+id/dpadLeft"
                    android:layout_width="30dp"
                    android:layout_height="40dp"
                    android:text="←"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="#2196F3"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/dpadRight"
                    android:layout_width="30dp"
                    android:layout_height="40dp"
                    android:text="→"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="#2196F3"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- D-Pad Bas -->
            <Button
                android:id="@+id/dpadDown"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:text="↓"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="#2196F3" />

        </LinearLayout>

        <!-- SÉPARATEUR -->
        <View
            android:layout_width="2dp"
            android:layout_height="120dp"
            android:background="#333333"
            android:layout_margin="8dp" />

        <!-- BOUTONS ACTION (A, B, X, Y) -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:gravity="center">

            <!-- Arrangement circulaire des boutons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center">

                <!-- Ligne 1: X, Y -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/buttonX"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:text="X"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:background="#FF6B6B"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/buttonY"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:text="Y"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:background="#FFD700"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <!-- Ligne 2: A, B -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="4dp">

                    <Button
                        android:id="@+id/buttonA"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:text="A"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:background="#00CC00"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/buttonB"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:text="B"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:background="#0066FF"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- SÉPARATEUR -->
        <View
            android:layout_width="2dp"
            android:layout_height="120dp"
            android:background="#333333"
            android:layout_margin="8dp" />

        <!-- BOUTONS SPÉCIAUX (SELECT, START, L1, R1) -->
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="8dp">

            <!-- Ligne 1: L1, R1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/buttonL1"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:text="L1"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#9C27B0"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/buttonR1"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:text="R1"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#9C27B0"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- Ligne 2: SELECT, START -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/buttonSelect"
                    android:layout_width="45dp"
                    android:layout_height="28dp"
                    android:text="SELECT"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="#CCCCCC"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/buttonStart"
                    android:layout_width="45dp"
                    android:layout_height="28dp"
                    android:text="START"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#FF5722"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>